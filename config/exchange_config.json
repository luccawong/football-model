{
  "engine_version": "GPT-EXCHANGE-1.0.0",
  "bridge_version": "EXCHANGE-BRIDGE-1.1.0",
  "primary_provider": "ODDSPAPI",
  "provider_mode": "BETFAIR_ORDERBOOK",
  "venue": "Betfair Exchange",
  "market_scope": ["MATCH_ODDS_1X2"],
  "sport_id": 10,
  "available_fields": [
    "best_back_price",
    "best_lay_price",
    "back_size",
    "lay_size",
    "back_ladder",
    "lay_ladder",
    "bookmaker_limit",
    "bookmakerChangedAt",
    "changedAt",
    "staleOdds"
  ],
  "derived_features": [
    "back_lay_spread_raw",
    "back_lay_spread_ticks",
    "order_book_depth",
    "order_book_imbalance",
    "back_implied_probability",
    "lay_implied_probability",
    "exchange_mid_probability",
    "exchange_normalized_probability",
    "price_velocity_from_saved_snapshots",
    "exchange_vs_bookmaker_divergence_pp"
  ],
  "unavailable_unless_explicitly_returned": [
    "total_matched",
    "traded_ladder",
    "traded_volume_velocity"
  ],
  "rules": {
    "prematch_only_for_prematch_sop": true,
    "market_mapping_required": true,
    "same_time_slice_required_for_cross_venue_comparison": true,
    "exchange_flow_not_smart_money_by_default": true,
    "order_book_imbalance_is_descriptive_not_ticket": true,
    "bookmakerChangedAt_and_changedAt_must_both_be_preserved": true,
    "staleOdds_is_a_qc_gate": true,
    "missing_feed_is_not_negative_evidence": true,
    "missing_deep_fields_must_remain_missing": true,
    "order_execution_is_research_only": true
  }
}
