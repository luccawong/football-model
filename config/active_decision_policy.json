    "check_draw_score_mass": true,
    "red_team_test_draw_as_leading_favourite_failure_path": true,
    "deep_favourite_cannot_be_justified_by_win_probability_alone": true
  },
  "underdog_outright_audit": {
    "enabled": true,
    "mandatory_trigger_favourite_handicap": "<=-0.75",
    "companies": [
      "William Hill",
      "Ladbrokes UK",
      "Bet365",
      "Pinnacle",
      "Interwetten",
      "Macau",
      "HKJC"
    ],
    "same_time_slice_required": true,
    "absolute_underdog_probability_is_not_a_rejection_rule": true,
    "separate_ah_cover_from_outright_win": true,
    "compare_structural_opening_divergence": true,
    "compare_later_divergence_expansion": true,
    "compare_company_residual_vs_match_median": true,
    "compare_abnormal_residual_vs_historical_company_bias_when_calibrated": true,
    "u_grade": ["U0", "U1", "U2", "U3"],
    "u_grade_is_evidence_quality_not_absolute_probability": true,
    "red_team_anti_favourite_rationalization_check": true
  },
  "one_x_two": {
    "devig_required": true,
    "real_odds_and_devig_probabilities_must_be_labeled_separately": true,
    "same_time_slice_required": true,
    "primary_pair": ["William Hill", "Ladbrokes UK"],
    "interwetten_role": "COLD_SIDE_UPSET_CHECK",
    "pinnacle_role": "CAPITAL_ANCHOR_NOT_AUTOMATIC_SMART_MONEY",
    "macau_role": "ASIAN_SIGNAL",
    "bet365_role": "KEY_COMPARATOR",
    "hkjc_role": "ASIAN_LOCAL_COMPARATOR",
    "favourite_failure_split_required": true
  },
  "totals": {
    "independent_from_ah": true,
    "dynamic_core": ["Macau", "Pinnacle", "Bet365"],
    "wh_lad_2_5_role": "BASE_2_5_PROBABILITY_ANCHOR",
    "ou_ladder_normalization_required_for_line_level_comparison": true,
    "jcb_sporttery_goal_count_primary": false,
    "jcb_sporttery_auxiliary_only_when_explicitly_supplied": true
  },
  "exchange": {
