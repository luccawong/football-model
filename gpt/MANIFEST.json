{
  "model": "GPT Football Model",
  "model_version": "GPT-FOOTBALL-FULLSTACK-1.1.0",
  "quant_engine": {
    "version": "GPT-QUANT-0.1.0",
    "entrypoint": "gpt/quant_core.py",
    "config": "config/quant_config.json",
    "protocol": "gpt/QUANT_PROTOCOL.md",
    "tests": "tests/test_quant_core.py",
    "status": "active"
  },
  "feature_engine": {
    "version": "GPT-FEATURE-1.0.0",
    "entrypoint": "gpt/feature_engine.py",
    "config": "config/full_stack_config.json",
    "registry": "config/module_registry.json",
    "protocol": "gpt/FULL_STACK_PROTOCOL.md",
    "tests": "tests/test_feature_engine.py",
    "status": "active"
  },
  "exchange_engine": {
    "version": "GPT-EXCHANGE-1.1.0",
    "entrypoint": "gpt/exchange_engine.py",
    "config": "config/exchange_config.json",
    "protocol": "gpt/EXCHANGE_PROTOCOL.md",
    "tests": "tests/test_exchange_engine.py",
    "status": "conditional_requires_feed"
  },
  "exchange_shadow_rule_engine": {
    "version": "BETFAIR-SHADOW-RULES-1.0.0",
    "entrypoint": "gpt/exchange_shadow_rules.py",
    "rulebook": "config/exchange_rulebook.json",
    "tests": "tests/test_exchange_shadow_rules.py",
