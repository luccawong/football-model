{
  "policy_version": "FOOTBALL-ACTIVE-DECISION-POLICY-2026-09-09.1",
  "effective_date": "2026-09-09",
  "authority": {
    "canonical_memory": "gpt/FOOTBALL_CANONICAL_MEMORY.md",
    "formal_sop": "gpt/FOOTBALL_SOP.md",
