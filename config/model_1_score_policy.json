{
  "policy_version": "MODEL_1-SCORE-POLICY-2.0.1",
  "model_id": "MODEL_1",
  "formal_stage14": "AUTO_CORRELATED_SCORE_ENGINE",
  "score_engine_modes": {
    "default": "AUTO",
    "HISTORICAL_BAYESIAN": "active historical prior + correlated market likelihood -> Bayesian posterior predictive",
    "MARKET_ONLY_FORMAL": "correlated market cluster log-rate distribution -> formal predictive",
    "AUTO": "ACTIVE approved prior uses HISTORICAL_BAYESIAN; otherwise MARKET_ONLY_FORMAL"
  },
  "prior": {
    "required": "ONLY_WHEN_MODE_IS_HISTORICAL_BAYESIAN",
    "engine": "gpt.prior_engine + gpt.prior_competition",
    "policy_ref": "config/model_1_prior_policy.json",
    "formal_source": "TITAN_HISTORICAL_MATCH_RESULTS_ONLY",
    "auto_resolution": "competition-aware prior_context + calibrated prior_store",
    "required_source_group": "TEAM_DATA",
    "required_covariance": "2x2_positive_definite",
    "uncertainty_method": "LAPLACE_FULL_PARAMETER_COVARIANCE_PROPAGATION",
    "fixed_score_covariance_forbidden": true,
    "market_as_prior_forbidden": true,
    "external_draw_label_as_prior_forbidden": true,
    "recent_match_mean_as_prior_forbidden": true,
    "unvalidated_numeric_context_forbidden": true
  },
  "market_fusion": {
    "companies": ["Pinnacle", "Bet365", "Macau"],
    "method": "CORRELATED_MARKET_CLUSTER_LOG_RATE",
    "independent_votes": false,
    "simple_final_lambda_average": false,
    "log_lambda_sigma_floor": 0.12,
    "sigma_floor_status": "PROVISIONAL_CALIBRATION_PARAMETER"
  },
  "context": {
    "allowed_only_when": "validated observation model with mean_log_lambda + cov_log_lambda",
    "qualitative_or_shadow_if_uncalibrated": true,
    "arbitrary_fixed_lambda_shift_forbidden": true
  },
  "anti_double_counting": {
    "prior_market_overlap_forbidden": true,
    "external_draw_teacher_in_prior_forbidden": true,
    "market_absorbed_fraction_requires_explicit_calibration": true,
    "default_market_absorbed_fraction": 0.0
  },
  "posterior_predictive": {
    "method": "MONTE_CARLO_LOG_LAMBDA",
    "default_draws": 4000,
    "minimum_draws": 500,
    "dixon_coles_rho": "validated historical prior if available, otherwise core-market median",
    "five_plus_tail_report": true
  },
  "top3": {
    "formal_source": "SELECTED_FORMAL_SCORE_ENGINE_PREDICTIVE_GRID",
    "raw_posterior_distribution_must_not_be_deleted": true,
    "winner_consistency": "HARD",
    "ah_consistency": "HARD when execution_path.ah is formal",
    "ah_positive_settlement_required": true,
    "ah_push_allowed_in_final_top3": false,
    "ah_examples": {
      "favorite_minus_1": "1-0, 2-1, 3-2 are ineligible because they only push",
      "favorite_minus_1_75": "2-1 is ineligible because it loses the selected AH side"
    },
    "ou_direction_required_before_final_top3": true,
    "ou_ticket_optional": true,
    "ou_direction_contract": "execution_path.ou must contain side=OVER|UNDER and line even when OU is not a formal betting ticket",
    "ou_consistency": "HARD for final Top3 once OU direction is set",
    "ou_hard_gate_required": true,
    "ou_push_allowed_in_final_top3": false,
    "ou_missing_action": "OU_DIRECTION_REQUIRED_NO_FORMAL_TOP3_RAW_TOP10_ONLY",
    "ou_must_not_flip_formal_ticket": true,
    "manual_reordering": false,
    "raw_top10_preserved": true,
    "robustness_frequency_required": true,
    "pipeline": "raw posterior score distribution -> winner/AH decision -> mandatory independent OU direction -> hard execution consistency filter -> final Top3"
  },
  "fallback": {
    "market_only_formal_stage14": true,
    "market_only_identity": "FORMAL_CORRELATED_MARKET_SCORE_MODEL",
    "market_reconstruction_research_only": true,
    "single_company_market_reconstruction_is_never_formal": true,
    "explicit_historical_missing_prior_action": "BAYESIAN_PRIOR_REQUIRED",
    "auto_shadow_prior_action": "MARKET_ONLY_FORMAL",
    "missing_core_market_action": "MISSING_CORE_MARKET",
    "market_must_never_be_labeled_historical_prior": true
  },
  "prior_usefulness_gate": {
    "version": "MODEL_1-PRIOR-USEFULNESS-1.0.0",
    "runtime_target_fields_forbidden": true,
    "domestic_default": "USE_MARKET_ONLY_UNTIL_TRAIN_ONLY_SUBSET_IS_APPROVED",
    "test_retuning_forbidden": true,
    "cannot_block_formal_market_score_output": true
  },
  "validation": {
    "required_metrics": [
      "Top1 exact score", "Top3 coverage", "correct-score NLL", "RPS", "1X2 Brier",
      "OU calibration/logloss", "AH settlement-aware calibration"
    ],
    "time_split_required": true,
    "random_shuffle_forbidden": true,
    "compare_market_only_vs_prior_only_vs_posterior": true,
    "select_by_top3_only": false,
    "historical_execution_filter_note": "do not invent a formal AH ticket from the archived market line; test runtime gate separately when formal execution_path is known"
  }
}
