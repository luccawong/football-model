{
  "policy_version": "MODEL_1-SCORE-POLICY-1.1.0",
  "model_id": "MODEL_1",
  "formal_stage14": "BAYESIAN_POSTERIOR_DIXON_COLES",
  "prior": {
    "required": true,
    "engine": "gpt.prior_engine",
    "policy_ref": "config/model_1_prior_policy.json",
    "formal_source": "TITAN_HISTORICAL_MATCH_RESULTS_ONLY",
    "auto_resolution": "prior_context + calibrated prior_store",
    "required_source_group": "TEAM_DATA",
    "required_covariance": "2x2_positive_definite",
    "uncertainty_method": "LAPLACE_FULL_PARAMETER_COVARIANCE_PROPAGATION",
    "fixed_score_covariance_forbidden": true,
    "market_as_prior_forbidden": true,
    "external_draw_label_as_prior_forbidden": true,
    "recent_match_mean_as_prior_forbidden": true,
    "unvalidated_numeric_context_forbidden": true
  },
  "market_fusion": {
    "companies": ["Pinnacle", "Bet365", "Macau"],
    "method": "CORRELATED_MARKET_CLUSTER_LOG_RATE",
    "independent_votes": false,
    "simple_final_lambda_average": false,
    "log_lambda_sigma_floor": 0.12,
    "sigma_floor_status": "PROVISIONAL_CALIBRATION_PARAMETER"
  },
  "context": {
    "allowed_only_when": "validated observation model with mean_log_lambda + cov_log_lambda",
    "qualitative_or_shadow_if_uncalibrated": true,
    "arbitrary_fixed_lambda_shift_forbidden": true
  },
  "anti_double_counting": {
    "prior_market_overlap_forbidden": true,
    "external_draw_teacher_in_prior_forbidden": true,
    "market_absorbed_fraction_requires_explicit_calibration": true,
    "default_market_absorbed_fraction": 0.0
  },
  "posterior_predictive": {
    "method": "MONTE_CARLO_LOG_LAMBDA",
    "default_draws": 4000,
    "minimum_draws": 500,
    "dixon_coles_rho": "validated historical prior if available, otherwise core-market median",
    "five_plus_tail_report": true
  },
  "top3": {
    "formal_source": "BAYESIAN_POSTERIOR_PREDICTIVE_GRID",
    "winner_consistency": "HARD",
    "ah_consistency": "HARD when execution_path.ah.hard_gate=true",
    "ou_consistency": "HARD only when execution_path.ou.hard_gate=true; otherwise ranking penalty",
    "manual_reordering": false,
    "raw_top10_preserved": true,
    "robustness_frequency_required": true
  },
  "fallback": {
    "market_only_formal_stage14": false,
    "market_reconstruction_research_only": true,
    "missing_prior_action": "MISSING_BAYESIAN_PRIOR",
    "missing_context_for_auto_prior_action": "MISSING_BAYESIAN_PRIOR_CONTEXT"
  },
  "validation": {
    "required_metrics": [
      "Top1 exact score",
      "Top3 coverage",
      "correct-score NLL",
      "RPS",
      "1X2 Brier",
      "OU calibration/logloss",
      "AH cover calibration"
    ],
    "time_split_required": true,
    "random_shuffle_forbidden": true,
    "compare_market_only_vs_prior_only_vs_posterior": true,
    "select_by_top3_only": false
  }
}
