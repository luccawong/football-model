    "mode": "SHADOW_RESEARCH",
    "formal_system_impact": false,
    "freeze_baseline_before_exchange": true,
    "titan_betfair_rows_are_not_true_oddspapi_exchange": true,
    "single_snapshot_is_not_smart_money": true,
    "runner_traded_volume_is_unsigned_cumulative": true,
    "do_not_sum_runner_traded_volume_as_market_total_matched": true,
    "missing_exchange_is_not_negative_evidence": true,
    "shadow_excluded_from_formal_statistics": true
