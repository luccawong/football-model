{
  "version": "MODEL_1-PREFLIGHT-POLICY-1.1.0",
  "model_id": "MODEL_1",
  "effective_date": "2026-09-14",
  "authorization": "Explicit user instruction: MODEL_1 SOP order detection is a hard execution gate; if any required stage is missing or out of order, formal ticket output is forbidden.",
  "formal": true,
  "stage_role": "PRE_TICKET_HARD_GATE_OUTSIDE_18_STAGE_ORDER",
  "failure_status": "PRECHECK_BLOCKED_NO_TICKET",
  "failure_is_not_pass": true,
  "purpose": "Stop formal output until the current MODEL_1 contract has actually been executed for the match, with all required SOP stages completed in the canonical order.",
  "sop_order_gate": {
    "enabled": true,
    "canonical_order_source": "config/active_decision_policy.json::analysis_order",
    "required_stage_count": 18,
    "require_all_stages_completed": true,
    "require_exact_sequence": true,
    "allow_stage_skip": false,
    "allow_stage_reorder": false,
    "allow_implicit_stage_completion": false,
    "allow_ticket_before_stage_18": false,
    "missing_one_stage_blocks_ticket": true,
    "out_of_order_stage_blocks_ticket": true,
    "stage_completion_must_be_traceable": true,
    "canonical_sequence": [
      "fundamentals",
      "market_snapshot",
      "opening_first_impression",
      "opening_rationality_lifecycle",
      "off_field_weather",
      "lineup_tactics",
      "one_x_two_with_real_vs_camouflage_open_audit",
      "asian_handicap_with_europe_asia_conversion_audit",
      "totals",
      "cross_market_coherence",
      "market_attraction",
      "external_draw_exclusion_and_winner_audit",
      "underdog_outright_audit",
      "correct_score_poisson_bayesian",
      "uncertainty_audit",
      "freeze_h1",
      "independent_red_team_h2",
      "formal_main_ticket"
    ],
    "failure_action": "STOP_AND_COMPLETE_MISSING_OR_OUT_OF_ORDER_STAGE_BEFORE_ANY_GRADE_OR_TICKET",
    "failure_must_not_be_converted_to_pass": true
  },
  "required_checks": [
    "current MODEL_1 policy loaded",
    "Titan match identity verified",
    "all 18 canonical SOP stages completed in exact order",
    "opening-only first impression completed",
    "same-time-slice market audit completed",
    "AH all-valid-MAIN-line company divergence audit completed",
    "AH line and water lifecycle completed",
    "1X2-to-AH coherence audit completed",
    "independent OU direction plus reference line completed even when OU is not a ticket",
    "correct-score direction consistency gate passed",
    "draw-exclusion state loaded",
    "independent Red Team H2 completed with formal verdict",
    "no unresolved critical execution conflict",
    "ticket-lock mechanism ready"
  ],
  "missing_data": {
    "noncritical_missing_allowed": true,
    "missing_core_data_must_be_disclosed": true,
    "missing_is_not_negative_evidence": true,
    "critical_execution_conflict_blocks_output": true
  },
  "output_semantics": {
    "formal_ticket_before_preflight_pass_forbidden": true,
    "A_range_or_B_range_grade_before_preflight_pass_forbidden": true,
    "formal_main_ticket_stage_cannot_self_validate_prior_missing_stages": true,
    "preflight_failure_requires_finishing_missing_work_not_switching_to_PASS": true,
    "formal_trace_must_store_preflight_result": true,
    "formal_trace_must_store_stage_completion_vector": true
  },
  "implementation": {
    "validator": "gpt/preflight_gate.py",
    "formal_trace_integration": "gpt/formal_trace.py",
    "tests": ["tests/test_preflight_gate.py", "tests/test_formal_trace.py"]
  }
}