{
  "version": "MODEL_1-OPENING-BASELINE-1.1.0",
  "model_id": "MODEL_1",
  "formal_stages": [1, 4],
  "purpose": "Preserve the pre-market league/team fair-opening reference used to judge whether an actual opening is reasonable, shallow or deep.",
  "rules": {
    "league_specific_calibration_preferred": true,
    "historical_real_opening_samples_are_preferred_for_reasonable_band_calibration": true,
    "generic_rating_to_goal_conversion_is_seed_only_not_formal_constant": true,
    "old_10_rating_points_about_1_goal_is_not_a_hard_rule": true,
    "home_away_structure": "LEAGUE_HFA_BASELINE_PLUS_TEAM_HOME_AWAY_RESIDUALS",
    "do_not_double_count_generic_home_advantage_and_generic_away_penalty": true,
    "team_home_residual_and_away_residual_may_adjust_league_hfa_when_supported": true,
    "if_league_calibration_missing": "MARK_UNCALIBRATED_AND_USE_A_WIDER_QUALITATIVE_REASONABLE_OPENING_BAND",
    "do_not_invent_precise_fair_line_when_calibration_is_missing": true
  },
  "historical_calibration_method": {
    "preferred_same_company_anchor": "HKJC opening 1X2 de-vig -> HKJC opening Asian main line",
    "reason": "Avoid contaminating league-opening calibration with cross-company quote-time differences or alternate-line selection.",
    "cross_company_opening_mix_for_calibration": false,
    "alternate_line_mix_for_calibration": false,
    "opening_band_difference_flags": {
      "0.25_handicap_step": "REVIEW_REQUIRED",
      "0.50_or_more_handicap_step": "STRUCTURAL_ANOMALY_ALERT"
    },
    "flags_are_diagnostic_not_ticket_triggers": true
  },
  "interpretation": {
    "reasonable_opening_band_is_reference_not_result_prediction": true,
    "actual_opening_must_then_be_compared_with_company_structure_lifecycle_attraction_and_counterfactual_adjacent_lines": true,
    "opening_reasonableness_does_not_delete_draw_or_force_favourite": true,
    "anomaly_alert_does_not_directly_create_a_ticket": true
  },
  "confidence_quality": {
    "secondary_or_low_information_competitions_require_wider_uncertainty": true,
    "unconfirmed_lineups_or_material_missing_market_timelines_can_cap_grade": true,
    "information_quality_can_lower_grade_but_under_current_policy_does_not_create_final_pass": true,
    "high_grade_requires_correspondingly_high_information_completeness_and_coherence": true
  }
}
