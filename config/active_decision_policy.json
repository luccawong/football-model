    "low_confidence_must_be_expressed_by_grade_not_pass": true,
    "ticket_lock_enabled": true,
    "later_change_requires_explicit_correction_old_to_new": true,
    "near_kickoff_ticket_first": true
  },
  "draw_exclusion_forward_test": {
    "enabled": true,
    "start_date": "2026-09-09",
    "planned_duration": "ONE_MONTH",
    "authoritative_pointer": "draw_exclusion/latest.json",
    "authoritative_daily_pattern": "draw_exclusion/daily/YYYY-MM-DD.json",
    "legacy_research_labels_are_not_execution_source": true,
    "excluded_1_is_hard_constraint": true,
    "excluded_1_remove_draw_from_execution_branch": true,
    "excluded_1_no_independent_veto_during_test": true,
    "not_excluded_0_requires_enhanced_draw_audit": true,
    "not_excluded_0_does_not_mean_draw_prediction": true,
    "unknown_or_absent_stays_unknown": true
